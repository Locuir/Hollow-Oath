  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c23573aac6c842542b1665777f9e3822, type: 3}
  m_Name: Guard 2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: What's going on here?
  - speakerName: Guard
    portrait: {fileID: 21300000, guid: deb435790b9949f478038d632b6701ed, type: 3}
    text: Same old nonsense. Another fool demanding to see the King.
  - speakerName: Prisoner
    portrait: {fileID: 21300000, guid: 486f321c347824440baeab97fee72251, type: 3}
    text: Please! Just let me speak to him! I have something he needs to hear.
  - speakerName: Guard
    portrait: {fileID: 21300000, guid: deb435790b9949f478038d632b6701ed, type: 3}
    text: Shut your mouth! We've heard enough
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: That's alright. I only need a moment of your time.
