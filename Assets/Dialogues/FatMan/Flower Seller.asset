MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c23573aac6c842542b1665777f9e3822, type: 3}
  m_Name: Flower Seller
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Flower Seller
    portrait: {fileID: 21300000, guid: ea2b242b9e016fb4585e072e5ec55c64, type: 3}
    text: Good day, traveler! Looking for something lovely?
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: Just passing through. Your village seems peaceful.
  - speakerName: Flower Seller
    portrait: {fileID: 21300000, guid: ea2b242b9e016fb4585e072e5ec55c64, type: 3}
    text: Oh, Grazlin has always been a quiet place. Though things have felt a little
      different lately.
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: Different? How so?
  - speakerName: Flower Seller
    portrait: {fileID: 21300000, guid: ea2b242b9e016fb4585e072e5ec55c64, type: 3}
    text: Ah, nothing worth troubling yourself over. The flowers have been selling
      well, at least!
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: I see. Well, have a good day.
  - speakerName: Flower Seller
    portrait: {fileID: 21300000, guid: ea2b242b9e016fb4585e072e5ec55c64, type: 3}
    text: You too, dear. And welcome to Grazlin!
