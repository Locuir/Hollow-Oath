%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c23573aac6c842542b1665777f9e3822, type: 3}
  m_Name: Guard 1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Guard
    portrait: {fileID: 21300000, guid: deb435790b9949f478038d632b6701ed, type: 3}
    text: Hey! You! What do you want?
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: I need to speak with the King.
  - speakerName: Guard
    portrait: {fileID: 21300000, guid: deb435790b9949f478038d632b6701ed, type: 3}
    text: Of course you do. That's all anyone ever wants
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: It's urgent. I have a message for him
  - speakerName: Guard
    portrait: {fileID: 21300000, guid: deb435790b9949f478038d632b6701ed, type: 3}
    text: Another one with an urgent message? How convenient.
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: We spoke just a few days ago. Surely you remember me.
  - speakerName: Guard
    portrait: {fileID: 21300000, guid: deb435790b9949f478038d632b6701ed, type: 3}
    text: ...Have we?
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: Yes. We spoke near the eastern gate
  - speakerName: Guard
    portrait: {fileID: 21300000, guid: deb435790b9949f478038d632b6701ed, type: 3}
    text: Well, I don't remember. And I don't have time for this.
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: That's alright. I only need a moment of your time.
  - speakerName: Guard
    portrait: {fileID: 21300000, guid: deb435790b9949f478038d632b6701ed, type: 3}
    text: You're not getting past me. Now move.
  - speakerName: Ashen
    portrait: {fileID: -1512766464214677766, guid: c3e96d18b70cd404aa460a0fcd1c3ec6, type: 3}
    text: -The player notices a man on the ground, held down by another guard-
